#!/bin/bash
#SBATCH --job-name=fastgs_mip360
#SBATCH --account=IscrC_EditGS
#SBATCH --partition=boost_usr_prod
#SBATCH --qos=normal
#SBATCH --time=10:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=64G
#SBATCH --output=logs/fastgs_mip360_%x_%j.out
#SBATCH --error=logs/fastgs_mip360_%x_%j.err

# Usage:
#   sbatch -J fastgs_mip360_g<SCENES_ID> slurm/run_mip360 <SCENES_ID>
# where <SCENES_ID> is 0, 1, or 2 (predefined 3-way split: 3 scenes / 2 / 2).
# The -J flag sets the job name, which gets baked into the log file name via %x.
# Submit all three in parallel:
#   for g in 0 1 2; do sbatch -J fastgs_mip360_g$g slurm/run_mip360 $g; done

set -euo pipefail

SCENES_ID="${1:-}"
if [[ -z "$SCENES_ID" ]]; then
    echo "ERROR: missing SCENES_ID positional argument (expected 0, 1, or 2)." >&2
    echo "Usage: sbatch $0 <SCENES_ID>" >&2
    exit 1
fi
if [[ "$SCENES_ID" != "0" && "$SCENES_ID" != "1" && "$SCENES_ID" != "2" ]]; then
    echo "ERROR: SCENES_ID must be 0, 1, or 2 (got '$SCENES_ID')." >&2
    exit 1
fi

# --- Modules (must match what was used to build the FastGS CUDA extensions) ---
module purge
module load profile/deeplrn
module load cuda/12.2
module load gcc/12.2.0

# --- Python env (uv venv) ---
source /leonardo_scratch/fast/IscrC_EditGS/envs/fastgs/bin/activate

# --- Env ---
export TORCH_CUDA_ARCH_LIST="8.0"   # A100
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

# --- Paths ---
DATA_DIR=/leonardo_work/IscrC_EditGS/datasets/mip360
OUTPUT_DIR=/leonardo_work/IscrC_EditGS/repos/FastGS/output/mip360

mkdir -p logs "$OUTPUT_DIR"

cd /leonardo_work/IscrC_EditGS/repos/FastGS

echo "[INFO] Running scene group $SCENES_ID on SLURM job $SLURM_JOB_ID"

# --gpu_device 0 because SLURM gives us GPU 0 inside the job
srun python scripts/benchmark_mip360_fastgs.py \
    --data_dir "$DATA_DIR" \
    --output_dir "$OUTPUT_DIR" \
    --gpu_device 0 \
    --scenes_id "$SCENES_ID"
